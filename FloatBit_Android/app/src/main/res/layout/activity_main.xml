<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◈"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/title"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_theme"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🌙"
            android:textSize="18sp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- 搜索 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/input_symbol"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:hint="@string/search_hint"
            android:textColorHint="@color/text_dim"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:inputType="textCapCharacters"
            android:imeOptions="actionSearch"
            android:maxLines="1" />

        <TextView
            android:id="@+id/btn_add"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_accent"
            android:gravity="center"
            android:text="@string/search"
            android:textColor="@color/on_accent"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/symbol_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="币安 USDⓈ-M 合约"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/network_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="网络"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/refresh_symbols"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:text="刷新"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 搜索结果 (默认隐藏) -->
    <LinearLayout
        android:id="@+id/search_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_card" />

    <!-- 热门币种 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingBottom="6dp"
        android:text="热门币种"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/hot_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 操作行: 配色 + 悬浮窗 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/btn_color"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:gravity="center"
            android:text="🟢 涨 / 🔴 跌"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_float"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_outline"
            android:gravity="center"
            android:text="@string/start_float"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 悬浮窗不透明度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="悬浮窗透明度"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seek_opacity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:max="100"
            android:progress="95" />

        <TextView
            android:id="@+id/tv_opacity"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="95%"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 我的自选 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="我的自选"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长按可拖动排序"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 行情列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />

    <!-- 底部署名 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="10dp"
        android:text="数据来自币安 · 作者 Nagnip"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

</LinearLayout>
